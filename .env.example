# SEAERP 환경변수 템플릿
# 이 파일을 .env.local로 복사해 값을 채운다. 실제 값은 이 파일에 쓰지 않는다.
# 목록 기준 = 코드에서 실제로 참조하는 이름(process.env.* 및 SDK 기본 조회).
# 주석은 키 위에 둔다 — 인라인 주석을 값으로 읽는 파서가 있다.

# ── 필수 ────────────────────────────────────────────────
# Airtable PAT
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# 관리 API 인증
ADMIN_SECRET=

# ── 운영 권장 ───────────────────────────────────────────
# Vercel cron 인증
CRON_SECRET=
# 일일 정산 메일
RESEND_API_KEY=
ALERT_EMAIL_TO=
# 미설정 시 onboarding@resend.dev
ALERT_EMAIL_FROM=
ALERT_THRESHOLD=
# 메일 내 대시보드 링크
NEXT_PUBLIC_BASE_URL=

# ── 입출고증·지출결의서 PDF 회사 정보 (lib/company-info.ts) ──
COMPANY_NAME=
COMPANY_REPRESENTATIVE=
COMPANY_BUSINESS_NUMBER=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_FAX=
COMPANY_EMAIL=

# ── 어황일보 번역 봇 (lib/eohwang/*) ────────────────────
# Anthropic SDK가 env에서 직접 읽는다
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── 선택: 테이블명 override ─────────────────────────────
# 미설정 시 lib/airtable-schema.ts의 기본값을 쓴다.
# AIRTABLE_WORKERS_TABLE=
# AIRTABLE_PRODUCTS_TABLE=
# AIRTABLE_LOT_TABLE=
# AIRTABLE_INBOUND_TABLE=
# AIRTABLE_OUTBOUND_TABLE=
# AIRTABLE_STORAGES_TABLE=
# AIRTABLE_STORAGE_COST_TABLE=
# AIRTABLE_SUPPLIERS_TABLE=
# AIRTABLE_TXN_TABLE=
# AIRTABLE_EOHWANG_DICT_TABLE=
# 미설정 시 "입고관리링크"
# AIRTABLE_LOT_TO_INBOUND_FIELD=

# ── 선택: 기타 ──────────────────────────────────────────
# N8N_APPROVAL_WEBHOOK_URL=

# NEXT_PUBLIC_APP_VERSION 은 next.config.ts가 package.json에서 주입한다. 직접 설정하지 않는다.
