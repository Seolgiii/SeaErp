# --- 필수 ---
# PAT: https://airtable.com/create/tokens
#   → Scope: data.records:read (검색/로그인), 쓰기 기능 쓰면 data.records:write
#   → Access: 이 앱이 붙일 베이스를 토큰에 반드시 추가
# 403 오류는 보통 (1) 베이스가 토큰에 안 넣어짐 (2) scope 부족 (3) AIRTABLE_BASE_ID 불일치
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# --- 선택: 테이블 이름이 lib/airtable-schema.ts 기본값과 다를 때만 ---
# 기본: 작업자 / 품목 마스터 / LOT별 재고 / 입출고 내역
# 값: 한글 테이블명 전체 또는 tblXXXXXXXX
# AIRTABLE_WORKERS_TABLE=
# AIRTABLE_PRODUCTS_TABLE=
# AIRTABLE_LOT_TABLE=
# AIRTABLE_TXN_TABLE=

# 출고 저장 시 LOT별 재고에서 입고 관리용 id를 꺼낼 링크 필드명(베이스 필드명과 동일). 기본값: 입고관리링크
# AIRTABLE_LOT_TO_INBOUND_FIELD=입고관리링크

# --- 선택: 관리자·웹훅 ---
# ADMIN_SECRET=
# N8N_APPROVAL_WEBHOOK_URL=

# --- 입출고 내역.상태 (Single select) 옵션 라벨 ---
# Airtable 필드에 미리 동일한 옵션을 만들어 두세요. 코드 기본값: 대기 / 승인 완료 / 입고
# 옵션 이름이 다르면 아래만 실제 옵션 텍스트와 맞추면 됩니다(따옴표 없이).
# AIRTABLE_TXN_STATUS_PENDING=대기
# AIRTABLE_TXN_STATUS_APPROVED=승인 완료
# AIRTABLE_TXN_STATUS_INBOUND=입고

# --- 회사 정보 (입고증/출고증 PDF 푸터에 표시) ---
# 환경변수로 주입. 값이 비어 있으면 PDF 푸터의 해당 행이 자동으로 생략됩니다.
# COMPANY_NAME=○○수산(주)
# COMPANY_REPRESENTATIVE=홍길동
# COMPANY_BUSINESS_NUMBER=123-45-67890
# COMPANY_ADDRESS=
# COMPANY_PHONE=
# COMPANY_FAX=
# COMPANY_EMAIL=
